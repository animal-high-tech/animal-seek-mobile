{
  "expo": {
    "name": "Animal Seek",
    "slug": "animal-seek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "animalseek",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.animalseek.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Animal Seek uses your location to share your last known position with your group.",
        "NSBluetoothAlwaysUsageDescription": "Animal Seek uses Bluetooth to discover nearby group members for offline ranging.",
        "NSBluetoothPeripheralUsageDescription": "Animal Seek uses Bluetooth to discover nearby group members for offline ranging."
      }
    },
    "android": {
      "package": "com.animalseek.app",
      "icon": "./assets/icon.png",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "248cd514-0743-4ba5-82af-607ff41efb71"
      }
    }
  }
}
